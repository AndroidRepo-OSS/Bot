# Android Repository Bot environment example.
#
# Copy this file to `.env` and replace every required placeholder before
# running `uv run androidrepo-bot` or `docker compose up --build bot`.
# The application reads `.env` and process environment variables prefixed with
# `AR_`; process environment values take precedence. Empty optional token
# values are ignored. Never commit the populated `.env` file.

# Telegram
# Required. Bot token issued by BotFather.
AR_BOT_TOKEN=replace-with-your-bot-token

# Required. Staff chat admitted to the post workflow.
# Telegram supergroup and channel IDs commonly start with `-100`.
AR_STAFF_CHAT_ID=-1001234567890

# Required. Positive message-thread ID for the staff topic where `/post`,
# `/cancel`, and draft callbacks are handled.
AR_POST_TOPIC_ID=123

# Required. Positive message-thread ID for best-effort operational audit
# messages. Audit delivery failures do not stop the main workflow.
AR_LOG_TOPIC_ID=456

# Required. Target channel for explicitly confirmed posts.
# The bot must have permission to copy messages into this channel.
AR_CHANNEL_ID=-1009876543210

# Runtime logging
# Optional. Accepted values: CRITICAL, ERROR, WARNING, INFO, DEBUG.
AR_LOG_LEVEL=INFO

# AI generation
# Required. OpenCode Zen credential used by the PydanticAI generation agent.
AR_OPENCODE_ZEN_API_KEY=replace-with-your-opencode-zen-api-key

# Optional. Non-empty OpenCode Zen model identifier.
AR_OPENCODE_ZEN_MODEL=deepseek-v4-flash

# Repository providers
# Optional. Leave blank for anonymous public API requests. Configure tokens for
# authenticated GitHub/GitLab requests and their associated rate limits.
AR_GITHUB_TOKEN=
AR_GITLAB_TOKEN=

# Persistence
# Required. Async SQLAlchemy PostgreSQL URL using the asyncpg driver.
#
# `postgres` is the internal Docker Compose service name. When the bot runs on
# the host, replace it with a PostgreSQL hostname reachable from the host.
# Alembic reads AR_DATABASE_URL from its process environment; it does not load
# this dotenv file itself.
AR_DATABASE_URL=postgresql+asyncpg://androidrepo:androidrepo@postgres:5432/androidrepo
